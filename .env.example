# ChannelOS environment configuration.
# Copy to .env and fill in real secrets. Never commit .env.

APP_ENV=development
APP_SECRET_KEY=
APP_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://channelos:channelos@postgres:5432/channelos
REDIS_URL=redis://redis:6379/0

# Sessions: absolute lifetime (seconds). Idle sessions also expire after 3 days.
SESSION_MAX_AGE_SECONDS=1209600
# Number of reverse proxies in front of the API whose X-Forwarded-For is
# trusted for client-IP rate limiting. 0 = use the TCP peer address.
TRUSTED_PROXY_COUNT=0
# Run background jobs inside the API process instead of the worker.
# Tests/demos only — never in production.
JOBS_INLINE=false

ADMIN_EMAIL=
ADMIN_PASSWORD=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION_ENCRYPTION_KEY=

TIMEWEB_AGENT_ACCESS_ID=3dce7cc5-7e2d-498b-9247-0b1f556cbb5d
TIMEWEB_AGENT_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/3dce7cc5-7e2d-498b-9247-0b1f556cbb5d/v1
TIMEWEB_AGENT_API_KEY=

TIMEWEB_TEXT_INPUT_RUB_PER_M=270
TIMEWEB_TEXT_OUTPUT_RUB_PER_M=1350
TIMEWEB_IMAGE_INPUT_RUB_PER_M=675
TIMEWEB_IMAGE_OUTPUT_RUB_PER_M=4050

# AI Gateway image provider — leave empty until a documented programmatic
# image endpoint for GPT Image 2.5 Sunburst is confirmed (see AI.md).
TIMEWEB_AI_GATEWAY_BASE_URL=https://api.timeweb.ai/v1
TIMEWEB_AI_GATEWAY_API_KEY=
TIMEWEB_IMAGE_MODEL=

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=channelos
S3_SECRET_KEY=channelos-secret
S3_BUCKET=channelos-media
S3_REGION=us-east-1

# Fake providers let the whole product flow run with zero real cost and zero
# real Telegram/Timeweb calls. Flip to false only once real credentials above
# are filled in.
USE_FAKE_AI_PROVIDER=true
USE_FAKE_IMAGE_PROVIDER=true
USE_FAKE_TELEGRAM_PROVIDER=true

VITE_API_BASE_URL=http://localhost:8000
